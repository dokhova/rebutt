# Скопируйте в .env.local для локального запуска.
# На Vercel: Project → Settings → Environment Variables (те же имена).

# ---------- OpenAI (только сервер, НЕ добавлять префикс VITE_) ----------
OPENAI_API_KEY=sk-...
# модель для советов/вопросов и для фото (по умолчанию gpt-5-mini)
OPENAI_MODEL=gpt-5-mini
# OPENAI_VISION_MODEL=gpt-5-mini
# OPENAI_REASONING_EFFORT=low
# лимит запросов к ИИ на пользователя в минуту
# AI_RATE_LIMIT_PER_MIN=12

# ---------- Supabase (Project Settings → API) ----------
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# ---------- PostHog (Project settings → Project API key) ----------
VITE_POSTHOG_KEY=phc_...
# EU-облако: https://eu.i.posthog.com, US-облако: https://us.i.posthog.com
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# ---------- необязательно ----------
# адрес API, если фронт и /api на разных доменах (по умолчанию тот же домен)
# VITE_API_BASE=https://your-app.vercel.app
